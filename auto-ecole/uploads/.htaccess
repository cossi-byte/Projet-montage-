# Les pièces des candidats ne sont JAMAIS servies directement :
# elles passent par fichier.php, qui vérifie les droits de l'utilisateur.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
# Ceinture et bretelles : aucun script ne peut s'exécuter ici
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php5 .php7 .php8 .phar
RemoveType .php .phtml .php5 .php7 .php8 .phar
