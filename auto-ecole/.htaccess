# Auto-école — réglages Apache
Options -Indexes
DirectoryIndex index.php

<FilesMatch "\.(sql|md|log|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Cache navigateur : les visiteurs sur connexion lente ne retéléchargent pas CSS/JS
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

# Taille des envois (3 pièces de 2 Mo maximum) — ignoré si l'hébergeur l'interdit
<IfModule mod_php.c>
    php_value upload_max_filesize 4M
    php_value post_max_size 12M
</IfModule>
