  "lines": [
    {"t": 0.2,   "who": "koko",    "text": "La la la, la la la !", "max": 2.2},
    {"t": 6.2,   "who": "koko",    "text": "Oh ! Un œuf !"},
    {"t": 7.9,   "who": "narr",    "text": "Un œuf est tombé du ciel !", "max": 2.1},
    {"t": 10.2,  "who": "koko",    "text": "Petit œuf, où est ta maman ?", "max": 2.1},
    {"t": 12.4,  "who": "koko",    "text": "Viens ! On va la trouver !", "max": 1.9},
    {"t": 14.5,  "who": "narr",    "text": "Et hop ! Koko part à l'aventure !", "max": 3.0},

    {"t": 18.4,  "who": "koko",    "text": "Oh oh ! Un gros tronc !", "max": 2.6},
    {"t": 22.1,  "who": "koko",    "text": "Un, deux, trois, hop !", "max": 2.0},
    {"t": 26.3,  "who": "monkey",  "giggle": 7, "text": "(rire)"},
    {"t": 30.2,  "who": "koko",    "text": "Bonjour ! C'est ton œuf ?", "max": 2.1},
    {"t": 32.4,  "who": "monkey",  "text": "Non, non, non ! Ce n'est pas mon œuf !", "max": 2.6},
    {"t": 36.3,  "who": "monkey",  "text": "Mais je vais t'aider !", "max": 2.2},
    {"t": 41.0,  "who": "koko",    "text": "Youpi !"},
    {"t": 44.2,  "who": "koko",    "text": "Merci, petit singe !", "max": 2.4},

    {"t": 47.0,  "who": "choir1",  "text": "Petit œuf, petit œuf,", "max": 1.85},
    {"t": 49.0,  "who": "choir1",  "text": "où est ta maman ?", "max": 1.85},
    {"t": 51.0,  "who": "choir1",  "text": "Tous ensemble,", "max": 1.85},
    {"t": 53.0,  "who": "choir1",  "text": "on la cherche en chantant !", "max": 1.85},

    {"t": 55.3,  "who": "narr",    "text": "Oh ! Une grande rivière qui brille !", "max": 3.2},
    {"t": 59.2,  "who": "koko",    "text": "Oh oh ! Ça glisse !", "max": 1.6},
    {"t": 64.7,  "who": "turtle",  "text": "Oh ! Bonjour !", "max": 2.0},
    {"t": 67.2,  "who": "koko",    "text": "Bonjour ! C'est ton œuf ?", "max": 2.0},
    {"t": 69.3,  "who": "turtle",  "text": "Non. Ce n'est pas mon œuf.", "max": 3.0},
    {"t": 73.0,  "who": "turtle",  "text": "Mais montez sur mon dos !", "max": 2.8},
    {"t": 77.4,  "who": "monkey",  "text": "Hourra ! Hourra !", "max": 1.6},
    {"t": 79.0,  "who": "koko",    "giggle": 6, "text": "(rire)"},
    {"t": 81.8,  "who": "koko",    "text": "Merci, Madame Tortue !", "max": 2.6},

    {"t": 85.0,  "who": "choir2",  "text": "Petit œuf, petit œuf,", "max": 1.85},
    {"t": 87.0,  "who": "choir2",  "text": "où est ta maman ?", "max": 1.85},
    {"t": 89.0,  "who": "choir2",  "text": "Tous ensemble,", "max": 1.85},
    {"t": 91.0,  "who": "choir2",  "text": "on la cherche en chantant !", "max": 1.85},

    {"t": 93.3,  "who": "narr",    "text": "Regarde ! Un nid, tout en haut de l'arbre géant !", "max": 3.6},
    {"t": 97.3,  "who": "koko",    "text": "Plus haut ! Encore plus haut !", "max": 2.5},
    {"t": 100.2, "who": "monkey",  "text": "Ouh là là !", "max": 1.4},
    {"t": 103.2, "who": "giraffe", "text": "Coucou, les amis !", "max": 2.4},
    {"t": 106.2, "who": "koko",    "text": "Bonjour ! C'est ton œuf ?", "max": 2.0},
    {"t": 108.3, "who": "giraffe", "text": "Non ! Mais je connais sa maman !", "max": 2.6},
    {"t": 111.6, "who": "giraffe", "text": "Grimpez sur mon cou !", "max": 2.4},
    {"t": 116.3, "who": "koko",    "text": "Wouah ! On monte, on monte !", "max": 2.8},
    {"t": 120.8, "who": "koko",    "text": "Voilà, petit œuf. Tout doux.", "max": 3.0},

    {"t": 124.3, "who": "narr",    "text": "Chut ! L'œuf bouge !", "max": 2.6},
    {"t": 130.2, "who": "koko",    "text": "Oh ! Un bébé oiseau !", "max": 2.3},
    {"t": 133.0, "who": "mama",    "text": "Mon bébé !", "max": 2.0},
    {"t": 136.6, "who": "chick",   "text": "Maman !"},
    {"t": 141.3, "who": "mama",    "text": "Merci, Koko ! Merci, les amis !", "max": 3.4},
    {"t": 146.3, "who": "narr",    "text": "Et maintenant, tout le monde danse !", "max": 3.2},

    {"t": 150.0, "who": "choir3",  "text": "Petit œuf, petit œuf,", "max": 1.85},
    {"t": 152.0, "who": "choir3",  "text": "où est ta maman ?", "max": 1.85},
    {"t": 154.0, "who": "choir3",  "text": "Tous ensemble,", "max": 1.85},
    {"t": 156.0, "who": "choir3",  "text": "on la cherche en chantant !", "max": 1.85},

